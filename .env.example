# VirtualGifts API — environment template
#
# Canonical variable reference (required/optional, defaults, semantics) lives in
# docs/architecture/06-infrastructure.md#configuration. This file is the runnable
# template — copy to `.env` for local development and fill in real values.
#
# Conventions:
#   - Production values live in the secret manager, NEVER in a committed file.
#   - Adding a variable: update 06-infrastructure.md AND this file AND the Joi
#     validator in @nestjs/config (see CLAUDE.md → Environment variables).
#   - "conditional" means "required when the related feature is enabled" (e.g.
#     STRIPE_* required only if Stripe is wired).

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public URL of the API itself (used in webhooks docs, signed URLs, etc.)
APP_URL=http://localhost:3000
# Storefront origin allowed by CORS + Clerk authorized parties
WEB_URL_ORIGIN=http://localhost:3001
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vg:vg@localhost:5432/vg_api_db
# Log every SQL query at debug level (noisy; off by default)
PRISMA_LOG_QUERIES=false

# ─── Redis (cache + future queue) ─────────────────────────────────────────────
# Required once the reports cache or BullMQ is wired
REDIS_URL=redis://localhost:6379

# ─── Clerk (auth) ─────────────────────────────────────────────────────────────
# See docs/architecture/08-auth-clerk.md
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional PEM for networkless token verification (recommended in prod)
CLERK_JWT_KEY=
# Svix signing secret for /api/v1/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Comma-separated list of origins allowed to mint tokens for this API
CLERK_AUTHORIZED_PARTIES=http://localhost:3001

# ─── Brevo (transactional email) ──────────────────────────────────────────────
# See docs/architecture/13-emails-brevo.md
BREVO_API_KEY=
BREVO_SENDER_NAME=VirtualGifts
BREVO_SENDER_EMAIL=no-reply@example.com
# Bearer token compared against the X-Mailin-Custom header on the Brevo webhook
BREVO_WEBHOOK_TOKEN=
# Set to "preview" in local dev to log emails instead of calling Brevo
MAIL_PROVIDER=brevo

# ─── Object storage ───────────────────────────────────────────────────────────
# See docs/architecture/12-uploads.md
# One of: s3 | cloudinary
STORAGE_PROVIDER=s3

# S3 (when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
# Only set for MinIO / LocalStack in dev — MUST be empty in production
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Cloudinary (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_URL=

# ─── Payments — Stripe ────────────────────────────────────────────────────────
# See docs/architecture/09-payments.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Payments — PayPal ────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ─── Payments — Binance Pay ───────────────────────────────────────────────────
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=

# ─── Payments — Lemon Squeezy ─────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ─── Payments — NOWPayments ───────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ─── Payments — BitPay ────────────────────────────────────────────────────────
BITPAY_TOKEN=
BITPAY_ENV=test
BITPAY_NOTIFICATION_TOKEN=

# ─── Throttler (global rate limit) ────────────────────────────────────────────
# See docs/architecture/06-infrastructure.md#throttler-tuning
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ─── Error tracking (optional, when wired) ────────────────────────────────────
SENTRY_DSN=
GIT_SHA=
